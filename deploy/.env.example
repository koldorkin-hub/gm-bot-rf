# Пример окружения РФ-сервера. Скопировать в .env и заполнить НА СЕРВЕРЕ.
# Файл .env в репозиторий не попадает (.gitignore) — секретов здесь быть не должно.

# ── Обязательное ──
PG_PASSWORD=                 # пароль роли gm_app: openssl rand -base64 24
N8N_ENCRYPTION_KEY=          # ключ учётных данных n8n: openssl rand -base64 32
                             # ⚠ Потеря = все учётные данные в n8n нечитаемы. В бэкап отдельно.
GM_FIELD_KEY=                # ключ полей контура здоровья: openssl rand -hex 32 (ровно 64 знака)
                             # ⚠ Потеря = контур здоровья не восстановить (КОНТУР-ЗДОРОВЬЯ.md).
N8N_HOST=                    # домен, на который смотрит вебхук Telegram, например bot.example.ru

# ── Значения по умолчанию, менять не обязательно ──
PG_DB=gm_memory
PG_USER=gm_app
TZ=Europe/Moscow
ASR_MODEL=gigaam-v3-e2e-rnnt

# ── Модель ──
# Путь 1 (по умолчанию): модель берётся по API у российского облака. Base URL и ключ
# прописываются в учётных данных n8n, а не здесь.
# Путь 2 (профиль gpu): своя карта.
VLLM_MODEL=
VLLM_REVISION=               # хеш коммита модели на HF — пин обязателен: мажоры выходят
                             # каждые 2–4 месяца, парсеры tool calling отстают на 1–3 недели
HF_TOKEN=
