[
  {
    "id": "LocalizeText01",
    "name": "Инструмент — Локализация текста",
    "active": false,
    "settings": { "executionOrder": "v1", "executionTimeout": 60 },
    "nodes": [
      {
        "parameters": {
          "inputSource": "workflowInputs",
          "workflowInputs": { "values": [ { "name": "text", "type": "string" }, { "name": "language", "type": "string" } ] }
        },
        "id": "lt-0000-0000-0000-000000000001",
        "name": "Триггер",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1.2,
        "position": [-700, 0]
      },
      {
        "parameters": {
          "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose", "version": 2 }, "combinator": "or", "conditions": [
            { "id": "c1", "leftValue": "={{ (String($json.language||'').toLowerCase().trim()) }}", "rightValue": "russian", "operator": { "type": "string", "operation": "contains" } },
            { "id": "c2", "leftValue": "={{ (String($json.language||'').toLowerCase().trim()) }}", "rightValue": "русск", "operator": { "type": "string", "operation": "contains" } },
            { "id": "c3", "leftValue": "={{ (String($json.language||'').toLowerCase().trim()) }}", "rightValue": "", "operator": { "type": "string", "operation": "empty", "singleValue": true } }
          ] },
          "options": {}
        },
        "id": "lt-0000-0000-0000-000000000002",
        "name": "Русский?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [-480, 0]
      },
      {
        "parameters": {
          "jsCode": "const d = $json;\nconst system = 'Ты — переводчик интерфейса фитнес-бота. Переведи текст СТРОГО на язык: ' + String(d.language||'') + '. Сохрани смысл и тёплый тон. ОБЯЗАТЕЛЬНО сохрани в точности: ВСЕ эмодзи, все переносы строк, все HTML-теги (<b>, </b>, <i> и т.п.) на своих местах вокруг переведённых слов, и команды со слэшем (/research, /language, /about, /support, /quiet) — их НЕ переводи. Верни ТОЛЬКО переведённый текст, без пояснений и без кавычек.';\nconst payload = { model: 'claude-haiku-4-5-20251001', max_tokens: 1500, system: system, messages: [{ role: 'user', content: String(d.text||'') }] };\nreturn [{ json: { payload } }];"
        },
        "id": "lt-0000-0000-0000-000000000003",
        "name": "Промпт",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-260, 120]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.anthropic.com/v1/messages",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "anthropicApi",
          "sendHeaders": true,
          "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" }, { "name": "content-type", "value": "application/json" } ] },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json.payload) }}",
          "options": { "timeout": 30000, "retry": { "retry": { "maxTries": 2, "waitBetweenTries": 1500 } } }
        },
        "id": "lt-0000-0000-0000-000000000004",
        "name": "Перевести",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [-40, 120],
        "credentials": { "anthropicApi": { "id": "J8w0oAhcMJCaC4PY", "name": "Anthropic account" } },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "let t = '';\ntry { t = $json.content[0].text; } catch (e) { t = ''; }\nt = String(t || '').trim();\nif (!t) { t = String($('Триггер').first().json.text || ''); }\nreturn [{ json: { text: t } }];"
        },
        "id": "lt-0000-0000-0000-000000000005",
        "name": "Готово (перевод)",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [180, 120]
      },
      {
        "parameters": {
          "assignments": { "assignments": [ { "id": "a1", "name": "text", "value": "={{ $('Триггер').first().json.text }}", "type": "string" } ] },
          "options": {}
        },
        "id": "lt-0000-0000-0000-000000000006",
        "name": "Готово (как есть)",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [-260, -120]
      }
    ],
    "connections": {
      "Триггер": { "main": [ [ { "node": "Русский?", "type": "main", "index": 0 } ] ] },
      "Русский?": { "main": [ [ { "node": "Готово (как есть)", "type": "main", "index": 0 } ], [ { "node": "Промпт", "type": "main", "index": 0 } ] ] },
      "Промпт": { "main": [ [ { "node": "Перевести", "type": "main", "index": 0 } ] ] },
      "Перевести": { "main": [ [ { "node": "Готово (перевод)", "type": "main", "index": 0 } ] ] }
    }
  }
]
