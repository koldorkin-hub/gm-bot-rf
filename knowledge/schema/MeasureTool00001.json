        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO measurement (bot_id, user_id, measured_on, metric, value, unit, source) VALUES ($1, $2, $3::date, $4, $5::numeric, $6, 'client');",
          "options": {
            "queryReplacement": "={{ [$json.bot_id, $json.user_id, $json.measured_on, $json.metric, $json.value, $json.unit] }}"
          }
        },
